{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STORK COMMAND Release Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "song", "strategy", "release_day", "spotify_url", "clips", "posts"],
  "properties": {
    "schema_version": {"type": "string"},
    "release_id": {"type": "string"},
    "song": {"type": "string"},
    "strategy": {"type": "string", "enum": ["pre_release", "release_day", "post_release"]},
    "release_day": {"type": "string"},
    "spotify_url": {"type": ["string", "null"]},
    "clips": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "start", "end", "platforms", "purpose", "format", "resolution", "hook"],
        "properties": {
          "id": {"type": "string"}, "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "platforms": {"type": "array", "items": {"type": "string", "enum": ["youtube_shorts", "instagram_reels", "tiktok"]}},
          "purpose": {"type": "string"}, "format": {"type": "string", "enum": ["9:16"]},
          "resolution": {"type": "string", "enum": ["1080x1920"]}, "hook": {"type": "string"}
        }
      }
    },
    "posts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "platform", "type", "publish_at", "clip_id", "caption", "cta", "hashtags", "title", "tiktok_mode"],
        "properties": {
          "id": {"type": "string"},
          "platform": {"type": "string", "enum": ["youtube", "youtube_shorts", "instagram_reels", "tiktok"]},
          "type": {"type": "string"}, "publish_at": {"type": "string"},
          "clip_id": {"type": ["string", "null"]}, "caption": {"type": "string"},
          "cta": {"type": "string"}, "hashtags": {"type": "array", "items": {"type": "string"}},
          "title": {"type": ["string", "null"]}, "tiktok_mode": {"type": ["string", "null"], "enum": ["draft", "direct", null]}
        }
      }
    }
  }
}
